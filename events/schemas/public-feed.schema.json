{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VitaBite public longevity-events feed",
  "type": "object",
  "required": [
    "schema_version",
    "publication_status",
    "generated_at",
    "last_successful_collection",
    "collection_status",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "publication_status": {
      "enum": [
        "editorial_pipeline_pending",
        "live",
        "metadata_roundup"
      ]
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_successful_collection": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collection_status": {
      "enum": [
        "not_connected_to_publication",
        "success",
        "partial",
        "failed"
      ]
    },
    "sources_succeeded": {
      "type": "integer",
      "minimum": 0
    },
    "sources_total": {
      "type": "integer",
      "minimum": 0
    },
    "source_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "fetched": {
            "type": "integer",
            "minimum": 0
          },
          "new": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "item_id",
        "title",
        "publisher",
        "author",
        "source_url",
        "publication_date",
        "publication_date_precision",
        "publication_date_raw",
        "location",
        "location_groups",
        "tags",
        "summary",
        "evidence_notes",
        "review_state"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "author": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "publication_date_precision": {
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ]
        },
        "publication_date_raw": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "location": {
          "enum": [
            "vienna",
            "europe",
            "us",
            "asia",
            "other"
          ]
        },
        "location_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vienna",
              "europe",
              "us",
              "asia"
            ]
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 50
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1200
        },
        "evidence_notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 800
        },
        "review_state": {
          "enum": [
            "approved",
            "candidate"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "review_state": {
                "const": "candidate"
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "type": "null"
              },
              "evidence_notes": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_state": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "collection_status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "sources_succeeded",
          "sources_total",
          "source_results"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "publication_status": {
            "const": "metadata_roundup"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "review_state": {
                  "const": "candidate"
                },
                "summary": {
                  "type": "null"
                },
                "evidence_notes": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_status": {
            "const": "live"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "review_state": {
                  "const": "approved"
                }
              }
            }
          }
        }
      }
    }
  ]
}
